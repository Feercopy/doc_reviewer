{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gate-challenger.local/schemas/summary-localization.schema.json",
  "title": "SummaryLocalization",
  "type": "object",
  "required": ["run_mode", "language", "short_summary", "product_analysis_markdown", "stage_checklist", "financial_analysis"],
  "additionalProperties": false,
  "properties": {
    "run_mode": { "type": "string", "const": "summary_localization" },
    "language": { "type": "string", "enum": ["ru", "en"] },
    "short_summary": { "type": ["string", "null"] },
    "product_analysis_markdown": { "type": ["string", "null"] },
    "stage_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": { "type": "string", "enum": ["green", "red"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "financial_analysis": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["run_mode", "verdict", "executive_brief", "confidence", "top_findings", "key_numbers", "spreadsheet_audit", "critical_risks", "data_gaps", "required_actions", "questions_for_team", "validation"],
          "additionalProperties": false,
          "properties": {
            "run_mode": { "type": "string", "const": "ic_agentic_review_compact" },
            "verdict": { "type": "string", "enum": ["GO", "CONDITIONAL", "NO-GO", "FREEZE", "UNKNOWN"] },
            "executive_brief": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "top_findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
            "key_numbers": { "type": "array", "items": { "$ref": "#/$defs/key_number" } },
            "spreadsheet_audit": { "$ref": "#/$defs/spreadsheet_audit" },
            "critical_risks": { "type": "array", "items": { "type": "string" } },
            "data_gaps": { "type": "array", "items": { "type": "string" } },
            "required_actions": { "type": "array", "items": { "type": "string" } },
            "questions_for_team": { "type": "array", "items": { "type": "string" } },
            "validation": { "$ref": "#/$defs/validation" }
          }
        }
      ]
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["title", "severity", "summary", "evidence", "recommendation"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["blocker", "critical", "high", "medium", "info", "data_gap"] },
        "summary": { "type": "string" },
        "evidence": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    },
    "key_number": {
      "type": "object",
      "required": ["label", "value", "unit", "source"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "unit": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "spreadsheet_audit": {
      "type": "object",
      "required": ["status", "summary", "formula_issues_count", "critical_formula_issues_count", "source_filename"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["not_provided", "completed", "failed"] },
        "summary": { "type": "string" },
        "formula_issues_count": { "type": "integer", "minimum": 0 },
        "critical_formula_issues_count": { "type": "integer", "minimum": 0 },
        "source_filename": { "type": ["string", "null"] }
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "summary", "warnings_count", "failures_count"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pass", "warn", "fail", "not_run"] },
        "summary": { "type": "string" },
        "warnings_count": { "type": "integer", "minimum": 0 },
        "failures_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
